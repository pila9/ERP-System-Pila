# Copy to .env and adjust only if you need to change ports or credentials.
WEB_PORT=8080
VITE_PORT=5173
APP_URL=http://localhost:8080

# Origin of the front-end allowed to call the API. Comma separate multiple
# origins, or leave empty to allow any origin (local development).
# CORS_ALLOWED_ORIGINS=https://erp.example.vercel.app
CORS_ALLOWED_ORIGINS=

# PostgreSQL (single source of truth for the whole stack)
DB_PORT=5432
POSTGRES_DB=erp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres