generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocumentSequence {
  id           String   @id @default(uuid())
  sequenceKey  String   @map("sequence_key")
  period       String
  number       Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sequenceKey, period])
  @@map("document_sequences")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  permissions Json?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("roles")
}

model User {
  id                String    @id @default(uuid())
  code              String?   @unique
  name              String
  email             String    @unique
  emailVerifiedAt   DateTime? @map("email_verified_at")
  password          String
  roleId            String?   @map("role_id")
  phone             String?
  avatar            String?
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  rememberToken     String?   @map("remember_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  role       Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  salesOrders      SalesOrder[]       @relation("SalesOrderUser")
  purchaseOrders   PurchaseOrder[]    @relation("PurchaseOrderUser")
  invoices         Invoice[]          @relation("InvoiceUser")
  payments         Payment[]          @relation("PaymentUser")
  stockMovements   StockMovement[]    @relation("StockMovementUser")

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  code        String?    @unique
  name        String
  parentId    String?    @map("parent_id")
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  abbreviation String  @unique @db.VarChar(20)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    Product[]

  @@map("units")
}

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  address     String?
  city        String?
  country     String?
  phone       String?
  manager     String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stockLevels     StockLevel[]
  stockMovements  StockMovement[]       @relation("StockMovementWarehouse")
  toStockMovements StockMovement[]      @relation("StockMovementToWarehouse")
  salesOrders     SalesOrder[]
  purchaseOrders  PurchaseOrder[]
  salesOrderItems SalesOrderItem[]

  @@map("warehouses")
}

model Product {
  id               String        @id @default(uuid())
  code             String        @unique
  sku              String?
  barcode          String?
  name             String
  description      String?
  categoryId       String?       @map("category_id")
  unitId           String?       @map("unit_id")
  costPrice        Decimal       @default(0) @db.Decimal(12, 2) @map("cost_price")
  salePrice        Decimal       @default(0) @db.Decimal(12, 2) @map("sale_price")
  taxRate          Decimal       @default(0) @db.Decimal(5, 2) @map("tax_rate")
  trackInventory   Boolean       @default(true) @map("track_inventory")
  reorderLevel     Decimal       @default(0) @db.Decimal(12, 2) @map("reorder_level")
  reorderQuantity  Decimal       @default(0) @db.Decimal(12, 2) @map("reorder_quantity")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit             Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  salesOrderItems  SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems     InvoiceItem[]

  @@index([name])
  @@index([isActive, categoryId])
  @@map("products")
}

model StockLevel {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  warehouseId   String   @map("warehouse_id")
  quantity      Decimal  @default(0) @db.Decimal(14, 3)
  reservedQty   Decimal  @default(0) @db.Decimal(14, 3) @map("reserved_quantity")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id              String    @id @default(uuid())
  number          String?
  productId       String    @map("product_id")
  warehouseId     String    @map("warehouse_id")
  toWarehouseId   String?   @map("to_warehouse_id")
  type            String    @db.VarChar(30)
  quantity        Decimal   @default(0) @db.Decimal(14, 3)
  unitCost        Decimal   @default(0) @db.Decimal(12, 2) @map("unit_cost")
  balanceAfter    Decimal   @default(0) @db.Decimal(14, 3) @map("balance_after")
  referenceId     String?   @map("reference_id")
  referenceType   String?   @map("reference_type")
  note            String?
  userId          String?   @map("user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse @relation("StockMovementWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  toWarehouse     Warehouse? @relation("StockMovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  user            User?     @relation("StockMovementUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model Customer {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  company         String?
  email           String?
  phone           String?
  taxNumber       String?  @map("tax_number")
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?  @map("postal_code")
  creditLimit     Decimal  @default(0) @db.Decimal(14, 2) @map("credit_limit")
  paymentTermsDays Int     @default(30) @map("payment_terms_days")
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  salesOrders     SalesOrder[]
  invoices        Invoice[]
  payments        Payment[]

  @@index([name])
  @@map("customers")
}

model Supplier {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  company         String?
  email           String?
  phone           String?
  taxNumber       String?  @map("tax_number")
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?  @map("postal_code")
  paymentTermsDays Int     @default(30) @map("payment_terms_days")
  bankName        String?  @map("bank_name")
  bankAccount     String?  @map("bank_account")
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrders  PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

model SalesOrder {
  id              String    @id @default(uuid())
  number          String    @unique
  customerId      String    @map("customer_id")
  userId          String?   @map("user_id")
  warehouseId     String?   @map("warehouse_id")
  orderDate       DateTime  @db.Date @map("order_date")
  expectedDate    DateTime? @db.Date @map("expected_date")
  status          String    @default("draft") @db.VarChar(20)
  discountType    String    @default("fixed") @db.VarChar(10) @map("discount_type")
  discountValue   Decimal   @default(0) @db.Decimal(12, 2) @map("discount_value")
  discountAmount  Decimal   @default(0) @db.Decimal(14, 2) @map("discount_amount")
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal   @default(0) @db.Decimal(14, 2) @map("tax_total")
  shipping        Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal   @default(0) @db.Decimal(14, 2) @map("grand_total")
  paidAmount      Decimal   @default(0) @db.Decimal(14, 2) @map("paid_amount")
  notes           String?
  terms           String?
  reference       String?
  confirmedAt     DateTime? @map("confirmed_at")
  shippedAt       DateTime? @map("shipped_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user            User?     @relation("SalesOrderUser", fields: [userId], references: [id], onDelete: SetNull)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items           SalesOrderItem[]
  invoices        Invoice[]

  @@index([status, orderDate])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                String   @id @default(uuid())
  salesOrderId      String   @map("sales_order_id")
  productId         String   @map("product_id")
  warehouseId       String?  @map("warehouse_id")
  quantity          Decimal  @db.Decimal(14, 3)
  fulfilledQty      Decimal  @default(0) @db.Decimal(14, 3) @map("fulfilled_quantity")
  unitPrice         Decimal  @default(0) @db.Decimal(12, 2) @map("unit_price")
  unitCost          Decimal  @default(0) @db.Decimal(12, 2) @map("unit_cost")
  discount          Decimal  @default(0) @db.Decimal(14, 2)
  taxRate           Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate")
  subtotal          Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(14, 2) @map("tax_amount")
  total             Decimal  @default(0) @db.Decimal(14, 2)
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  invoiceItems      InvoiceItem[]

  @@index([productId])
  @@map("sales_order_items")
}

model PurchaseOrder {
  id              String    @id @default(uuid())
  number          String    @unique
  supplierId      String    @map("supplier_id")
  userId          String?   @map("user_id")
  warehouseId     String?   @map("warehouse_id")
  orderDate       DateTime  @db.Date @map("order_date")
  expectedDate    DateTime? @db.Date @map("expected_date")
  receivedAt      DateTime? @map("received_at")
  status          String    @default("draft") @db.VarChar(20)
  discountType    String    @default("fixed") @db.VarChar(10) @map("discount_type")
  discountValue   Decimal   @default(0) @db.Decimal(12, 2) @map("discount_value")
  discountAmount  Decimal   @default(0) @db.Decimal(14, 2) @map("discount_amount")
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal   @default(0) @db.Decimal(14, 2) @map("tax_total")
  shipping        Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal   @default(0) @db.Decimal(14, 2) @map("grand_total")
  paidAmount      Decimal   @default(0) @db.Decimal(14, 2) @map("paid_amount")
  notes           String?
  terms           String?
  reference       String?
  orderedAt       DateTime? @map("ordered_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user            User?     @relation("PurchaseOrderUser", fields: [userId], references: [id], onDelete: SetNull)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items           PurchaseOrderItem[]

  @@index([status, orderDate])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String   @id @default(uuid())
  purchaseOrderId   String   @map("purchase_order_id")
  productId         String   @map("product_id")
  quantity          Decimal  @db.Decimal(14, 3)
  receivedQty       Decimal  @default(0) @db.Decimal(14, 3) @map("received_quantity")
  unitPrice         Decimal  @default(0) @db.Decimal(12, 2) @map("unit_price")
  unitCost          Decimal  @default(0) @db.Decimal(12, 2) @map("unit_cost")
  discount          Decimal  @default(0) @db.Decimal(14, 2)
  taxRate           Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate")
  subtotal          Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(14, 2) @map("tax_amount")
  total             Decimal  @default(0) @db.Decimal(14, 2)
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("purchase_order_items")
}

model Invoice {
  id              String    @id @default(uuid())
  number          String    @unique
  customerId      String    @map("customer_id")
  salesOrderId    String?   @map("sales_order_id")
  userId          String?   @map("user_id")
  invoiceDate     DateTime  @db.Date @map("invoice_date")
  dueDate         DateTime? @db.Date @map("due_date")
  status          String    @default("draft") @db.VarChar(20)
  discountType    String    @default("fixed") @db.VarChar(10) @map("discount_type")
  discountValue   Decimal   @default(0) @db.Decimal(12, 2) @map("discount_value")
  discountAmount  Decimal   @default(0) @db.Decimal(14, 2) @map("discount_amount")
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal   @default(0) @db.Decimal(14, 2) @map("tax_total")
  shipping        Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal   @default(0) @db.Decimal(14, 2) @map("grand_total")
  paidAmount      Decimal   @default(0) @db.Decimal(14, 2) @map("paid_amount")
  notes           String?
  terms           String?
  sentAt          DateTime? @map("sent_at")
  paidAt          DateTime? @map("paid_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  user            User?         @relation("InvoiceUser", fields: [userId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        Payment[]

  @@index([status, invoiceDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  productId         String?  @map("product_id")
  salesOrderItemId  String?  @map("sales_order_item_id")
  description       String?
  quantity          Decimal  @default(1) @db.Decimal(14, 3)
  unitPrice         Decimal  @default(0) @db.Decimal(12, 2) @map("unit_price")
  discount          Decimal  @default(0) @db.Decimal(14, 2)
  taxRate           Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate")
  subtotal          Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(14, 2) @map("tax_amount")
  total             Decimal  @default(0) @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  salesOrderItem    SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id          String   @id @default(uuid())
  number      String   @unique
  invoiceId   String?  @map("invoice_id")
  customerId  String?  @map("customer_id")
  userId      String?  @map("user_id")
  amount      Decimal  @db.Decimal(14, 2)
  paidAt      DateTime @map("paid_at")
  method      String   @default("cash") @db.VarChar(30)
  reference   String?
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user        User?     @relation("PaymentUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@index([invoiceId])
  @@map("payments")
}
